# Docker Compose reads this when copied to .env. Java reads environment variables directly.
SIGNALPILOT_BIND=127.0.0.1
PORT=8091
SIGNALPILOT_OPERATOR_TOKEN=replace-with-a-random-long-operator-token
SIGNALPILOT_MCP_TOKEN=replace-with-a-different-random-long-mcp-token
SIGNALPILOT_ORIGIN=http://127.0.0.1:8091
SIGNALPILOT_RATE_LIMIT_PER_MINUTE=120
SIGNALPILOT_BRIEF_RATE_LIMIT_PER_MINUTE=6
SIGNALPILOT_MAX_CONCURRENT_REQUESTS=8
DATABASE_URL=jdbc:h2:file:./data/signalpilot;DB_CLOSE_ON_EXIT=FALSE
DATABASE_USERNAME=sa
DATABASE_PASSWORD=
AI_PROVIDER=local
AWS_REGION=us-east-1
BEDROCK_MODEL=amazon.nova-lite-v1:0
